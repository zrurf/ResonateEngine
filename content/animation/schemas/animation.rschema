<?xml version="1.0" encoding="utf-8"?>
<schema module="resonate.animation">
  <!-- The animation domain's authored surface. The player materializes its
       runtime AnimationState from an Animation component: the clip id resolves
       through the products manifest, the flags seed the state's playback. -->

  <!-- The authored clip reference and its playback flags. The two halves are
       one asset id; the scene format authors it as clip="@guid[:sub]". -->
  <component name="Animation" version="1">
    <field name="clip_low" type="u64"/>
    <field name="clip_high" type="u64"/>
    <field name="looping" type="bool" default="true"/>
    <field name="speed" type="f32" default="1"/>
  </component>

  <!-- An authored state machine: a Machine element inside an Object, whose
       states name clips by asset reference and whose edges cross-fade. The
       numbers and flags author as strings and the scene adapter parses them;
       node authoring fields are text only. -->
  <node name="Machine" version="1">
    <field name="entry" type="string"/>
  </node>

  <!-- The state's name is the core `name` attribute, like an Object's. -->
  <node name="State" version="1">
    <field name="clip" type="string"/>
    <field name="looping" type="string"/>
  </node>

  <node name="Transition" version="1">
    <field name="from" type="string"/>
    <field name="to" type="string"/>
    <field name="at_end" type="string"/>
    <field name="fade" type="string"/>
    <field name="sync" type="string"/>
  </node>

</schema>
