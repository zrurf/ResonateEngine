<?xml version="1.0" encoding="utf-8"?>
<document version="1" schemas="resonate.scene">
  <!-- The demo's scene: one root, the camera and sun, the ground plane and the
       nine checker boxes. The middle box cross-fades between the authored bob
       and spin clips, driven by the input_x parameter (hold right to spin) --
       animation and its logic are content, not start-up code. -->

  <Scene key="demo">
    <Resources>
      <Resource key="checker" asset="@0704c7df-7013-4c31-818d-b515207bb7df"/>
      <Resource key="bob" asset="@15cc75a0-14ca-4c8e-b752-bf5ac010bc9a"/>
      <Resource key="spin" asset="@075a7fcb-478e-4962-b2ef-0b37cdf9641a"/>
    </Resources>
    <Object key="scene-root" name="动作演示">
      <Object key="camera" name="主相机">
        <Camera fov_y_degrees="60" near_z="0.1" far_z="1000"/>
        <LocalTransform position="0 2.5 -7"/>
      </Object>
      <Object key="sun" name="平行光">
        <DirectionalLight direction="0.35 -1 0.25" color="1 0.96 0.88" intensity="1.1"/>
      </Object>
      <Object key="ground" name="地面">
        <MeshInstance mesh="2"/>
        <LocalTransform position="0 0 0"/>
      </Object>

      <Object key="box-a1" name="箱子 A">
        <MeshInstance mesh="1" color="0.9 0.45 0.35"/>
        <Material texture="#checker"/>
        <LocalTransform position="-2.5 0.5 0"/>
      </Object>
      <Object key="box-a2" name="箱子 A">
        <MeshInstance mesh="1" color="0.95 0.65 0.3"/>
        <Material texture="#checker"/>
        <LocalTransform position="-2.5 0.5 2.5"/>
      </Object>
      <Object key="box-a3" name="箱子 A">
        <MeshInstance mesh="1" color="0.55 0.8 0.4"/>
        <Material texture="#checker"/>
        <LocalTransform position="-2.5 0.5 5"/>
      </Object>

      <Object key="box-b1" name="箱子 B">
        <MeshInstance mesh="1" color="0.35 0.75 0.7"/>
        <Material texture="#checker"/>
        <LocalTransform position="0 0.5 0"/>
      </Object>
      <Object key="box-center" name="箱子 B">
        <MeshInstance mesh="1" color="0.4 0.55 0.9"/>
        <Material texture="#checker"/>
        <Machine entry="bob" parameters="input_x">
          <State name="bob" clip="#bob"/>
          <State name="spin" clip="#spin"/>
          <Transition from="bob" to="spin" fade="0.4">
            <Condition parameter="input_x" greater="0.5"/>
          </Transition>
          <Transition from="spin" to="bob" fade="0.4">
            <Condition parameter="input_x" less="0.5"/>
          </Transition>
        </Machine>
        <LocalTransform position="0 0.5 2.5"/>
      </Object>
      <Object key="box-b3" name="箱子 B">
        <MeshInstance mesh="1" color="0.6 0.45 0.9"/>
        <Material texture="#checker"/>
        <LocalTransform position="0 0.5 5"/>
      </Object>

      <Object key="box-c1" name="箱子 C">
        <MeshInstance mesh="1" color="0.85 0.4 0.7"/>
        <Material texture="#checker"/>
        <LocalTransform position="2.5 0.5 0"/>
      </Object>
      <Object key="box-c2" name="箱子 C">
        <MeshInstance mesh="1" color="0.9 0.85 0.4"/>
        <Material texture="#checker"/>
        <LocalTransform position="2.5 0.5 2.5"/>
      </Object>
      <Object key="box-c3" name="箱子 C">
        <MeshInstance mesh="1" color="0.45 0.85 0.85"/>
        <Material texture="#checker"/>
        <LocalTransform position="2.5 0.5 5"/>
      </Object>
    </Object>
  </Scene>
</document>
