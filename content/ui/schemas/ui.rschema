<?xml version="1.0" encoding="utf-8"?>
<schema module="resonate.ui">

  <!-- How a canvas updates: retained widgets rerender on change, immediate
       subtrees rebuild their commands every frame. -->
  <enum name="UpdateMode" width="u8">
    <value name="Retained"/>
    <value name="Immediate"/>
  </enum>

  <!-- A widget either takes its place from its parent's flow or keeps its
       anchors and ignores that flow. -->
  <enum name="PositionMode" width="u8">
    <value name="Relative"/>
    <value name="Absolute"/>
  </enum>

  <enum name="FlexDirection" width="u8">
    <value name="Row"/>
    <value name="Column"/>
  </enum>

  <enum name="Justify" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
    <value name="SpaceBetween"/>
  </enum>

  <enum name="Align" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
    <value name="Stretch"/>
  </enum>

  <enum name="TextAlign" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
  </enum>

  <enum name="WidgetState" width="u8">
    <value name="Normal"/>
    <value name="Hovered"/>
    <value name="Pressed"/>
    <value name="Disabled"/>
  </enum>

  <!-- The root marker. Its rectangle is the target the layout pass is given;
       scale is the one global factor between authored pixels and the target. -->
  <component name="Canvas" version="1">
    <field name="mode" type="UpdateMode" default="Retained"/>
    <field name="scale" type="f32" default="1.0"/>
  </component>

  <!-- A widget's place in its parent. anchor_min and anchor_max select the
       parent fraction the widget is tied to, x/y offset the pivot from that
       anchor point, and width/height are added to the anchor span, so a
       stretched widget uses negative insets. pivot is the fraction of its own
       box the offsets name. -->
  <component name="RectTransform" version="1">
    <field name="x" type="f32" default="0"/>
    <field name="y" type="f32" default="0"/>
    <field name="width" type="f32" default="0"/>
    <field name="height" type="f32" default="0"/>
    <field name="anchor_min" type="vec2" default="0 0"/>
    <field name="anchor_max" type="vec2" default="0 0"/>
    <field name="pivot" type="vec2" default="0 0"/>
    <field name="z" type="i32" default="0"/>
    <field name="position" type="PositionMode" default="Relative"/>
  </component>

  <!-- A container's flow: children are visited in the hierarchy's insertion
       order, gap separates neighbours, padding shrinks the content box. -->
  <component name="LayoutGroup" version="1">
    <field name="direction" type="FlexDirection" default="Row"/>
    <field name="justify" type="Justify" default="Start"/>
    <field name="align" type="Align" default="Start"/>
    <field name="gap" type="f32" min="0" default="0"/>
    <field name="padding_left" type="f32" min="0" default="0"/>
    <field name="padding_top" type="f32" min="0" default="0"/>
    <field name="padding_right" type="f32" min="0" default="0"/>
    <field name="padding_bottom" type="f32" min="0" default="0"/>
  </component>

  <!-- Written by the layout pass, in target pixels. Consumers (render, hit
       test) read this instead of repeating the anchor and flow math. -->
  <component name="ComputedRect" version="1" derived="true">
    <field name="x" type="f32"/>
    <field name="y" type="f32"/>
    <field name="width" type="f32"/>
    <field name="height" type="f32"/>
  </component>

  <!-- A flat fill. The style compiler will resolve it from a class set; until
       then a widget carries its color directly. -->
  <component name="Background" version="1">
    <field name="color" type="vec4" default="1 1 1 1"/>
  </component>

  <!-- A textured rectangle. `texture` names an engine texture id (0 = white,
       1 = the built-in checker); the UV rect selects the sampled region and
       tint multiplies the sample. -->
  <component name="Image" version="1">
    <field name="texture" type="u32" default="0"/>
    <field name="uv_min" type="vec2" default="0 0"/>
    <field name="uv_max" type="vec2" default="1 1"/>
    <field name="tint" type="vec4" default="1 1 1 1"/>
  </component>

  <!-- A shaped run: the UTF-8 bytes in a blob, the size in pixels and the
       color the coverage masks. The adapter fills it from the Label's text
       authoring property. -->
  <component name="Text" version="1">
    <field name="content" type="blob"/>
    <field name="font_size" type="f32" default="24"/>
    <field name="text_color" type="vec4" default="1 1 1 1"/>
    <field name="align" type="TextAlign" default="Start"/>
    <field name="wrap" type="bool" default="true"/>
  </component>

  <!-- Compiled glyph quads in widget-local pixels: x/y/width/height plus the
       atlas UV rect. Derived by the adapter from Text. -->
  <component name="Glyphs" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- The shaped run's measured extent, written by the adapter. Layout uses it
       when the RectTransform leaves a dimension at zero. -->
  <component name="TextMetrics" version="1" derived="true">
    <field name="width" type="f32"/>
    <field name="height" type="f32"/>
  </component>

  <!-- The canvas's single font atlas: RGBA8 coverage pages and the revision
       the renderer compares before re-uploading. Derived by the adapter. -->
  <component name="TextAtlasPage" version="1" derived="true">
    <field name="width" type="u32"/>
    <field name="height" type="u32"/>
    <field name="revision" type="u32"/>
    <field name="pixels" type="blob"/>
  </component>

  <!-- The HUD's view model: gameplay or the demo writes these values; widgets
       bind their RectTransform fields to them. A later slice can bind straight
       to gameplay components. -->
  <component name="DataContext" version="1">
    <field name="health" type="f32" default="0"/>
    <field name="max_health" type="f32" default="1"/>
    <field name="ammo" type="f32" default="0"/>
    <field name="max_ammo" type="f32" default="1"/>
  </component>

  <!-- Compiled binding records, written by the UI adapter; a blob on the
       canvas so the binding system reads one dense range. -->
  <component name="Bindings" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- Interaction state of a widget. `activated` is true for the update in
       which a press was released inside it. -->
  <component name="Input" version="1">
    <field name="state" type="WidgetState" default="Normal"/>
    <field name="focusable" type="bool" default="true"/>
    <field name="activated" type="bool" default="false"/>
  </component>

  <!-- The pointer's current target, derived by the input system. -->
  <component name="PointerState" version="1" derived="true">
    <field name="hover" type="entity"/>
    <field name="press" type="entity"/>
    <field name="activated" type="entity"/>
    <field name="down" type="bool"/>
  </component>

  <!-- State-style overrides, compiled at instantiation; a blob on the canvas. -->
  <component name="StateStyles" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- Reserved for the style compiler: the interned table entry a widget's
       class set resolves to. Layout does not read it. -->
  <component name="StyleRef" version="1">
    <field name="style" type="u32" default="0"/>
  </component>

  <!-- Named compositions. A node type is a flat set of components plus the
       fields its implicit attributes may set; there is no inheritance. -->
  <node name="Screen" version="1">
    <uses component="Canvas" expose="scale"/>
    <uses component="DataContext" expose="health max_health ammo max_ammo"/>
  </node>

  <node name="Panel" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color"/>
    <uses component="LayoutGroup"
          expose="direction justify align gap padding_left padding_top padding_right padding_bottom"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Label" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color"/>
    <uses component="Text" expose="font_size text_color align wrap"/>
    <field name="text" type="string"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Box" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Picture" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Image" expose="texture uv_min uv_max tint"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Button" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color"/>
    <uses component="Input"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <!-- Non-visual style data. The UI compiler consumes the sheet; instantiation
       skips its subtree. A rule's component elements are declarations. -->
  <node name="StyleSheet" version="1"/>

  <node name="StyleRule" version="1">
    <field name="selector" type="string"/>
  </node>

</schema>
