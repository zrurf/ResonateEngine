<?xml version="1.0" encoding="utf-8"?>
<schema module="resonate.ui">

  <!-- How a canvas updates: retained widgets rerender on change, immediate
       subtrees rebuild their commands every frame. -->
  <enum name="UpdateMode" width="u8">
    <value name="Retained"/>
    <value name="Immediate"/>
  </enum>

  <!-- A widget either takes its place from its parent's flow or keeps its
       anchors and ignores that flow. -->
  <enum name="PositionMode" width="u8">
    <value name="Relative"/>
    <value name="Absolute"/>
  </enum>

  <enum name="FlexDirection" width="u8">
    <value name="Row"/>
    <value name="Column"/>
  </enum>

  <enum name="Justify" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
    <value name="SpaceBetween"/>
  </enum>

  <enum name="Align" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
    <value name="Stretch"/>
  </enum>

  <enum name="TextAlign" width="u8">
    <value name="Start"/>
    <value name="Center"/>
    <value name="End"/>
  </enum>

  <enum name="VAlign" width="u8">
    <value name="Top"/>
    <value name="Middle"/>
    <value name="Bottom"/>
  </enum>

  <enum name="WidgetState" width="u8">
    <value name="Normal"/>
    <value name="Hovered"/>
    <value name="Pressed"/>
    <value name="Disabled"/>
    <value name="Focused"/>
  </enum>

  <!-- The root marker. Its rectangle is the target the layout pass is given;
       scale is the one global factor between authored pixels and the target. -->
  <component name="Canvas" version="1">
    <field name="mode" type="UpdateMode" default="Retained"/>
    <field name="scale" type="f32" default="1.0"/>
  </component>

  <!-- A widget's place in its parent. anchor_min and anchor_max select the
       parent fraction the widget is tied to, x/y offset the pivot from that
       anchor point, and width/height are added to the anchor span, so a
       stretched widget uses negative insets. pivot is the fraction of its own
       box the offsets name. -->
  <component name="RectTransform" version="1">
    <field name="x" type="f32" default="0"/>
    <field name="y" type="f32" default="0"/>
    <field name="width" type="f32" default="0"/>
    <field name="height" type="f32" default="0"/>
    <field name="anchor_min" type="vec2" default="0 0"/>
    <field name="anchor_max" type="vec2" default="0 0"/>
    <field name="pivot" type="vec2" default="0 0"/>
    <field name="z" type="i32" default="0"/>
    <field name="position" type="PositionMode" default="Relative"/>
  </component>

  <!-- A container's flow: children are visited in the hierarchy's insertion
       order, gap separates neighbours, padding shrinks the content box. -->
  <component name="LayoutGroup" version="2">
    <field name="direction" type="FlexDirection" default="Row"/>
    <field name="justify" type="Justify" default="Start"/>
    <field name="align" type="Align" default="Start"/>
    <field name="gap" type="f32" min="0" default="0"/>
    <field name="padding_left" type="f32" min="0" default="0"/>
    <field name="padding_top" type="f32" min="0" default="0"/>
    <field name="padding_right" type="f32" min="0" default="0"/>
    <field name="padding_bottom" type="f32" min="0" default="0"/>
    <!-- Wrap starts a new line when the next child would pass the content
         extent; each line justifies and aligns on its own. -->
    <field name="wrap" type="bool" default="false"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- Written by the layout pass, in target pixels. Consumers (render, hit
       test) read this instead of repeating the anchor and flow math. -->
  <component name="ComputedRect" version="1" derived="true">
    <field name="x" type="f32"/>
    <field name="y" type="f32"/>
    <field name="width" type="f32"/>
    <field name="height" type="f32"/>
  </component>

  <!-- A flat fill. The style compiler will resolve it from a class set; until
       then a widget carries its color directly. -->
  <component name="Background" version="2">
    <field name="color" type="vec4" default="1 1 1 1"/>
    <!-- An outline drawn inside the rect on all four edges; zero width draws
         none. -->
    <field name="border_color" type="vec4" default="0 0 0 0"/>
    <field name="border_width" type="f32" default="0.0"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- A textured rectangle. `texture` names an engine texture id (0 = white,
       1 = the built-in checker); the UV rect selects the sampled region and
       tint multiplies the sample. -->
  <component name="Image" version="1">
    <field name="texture" type="u32" default="0"/>
    <field name="uv_min" type="vec2" default="0 0"/>
    <field name="uv_max" type="vec2" default="1 1"/>
    <field name="tint" type="vec4" default="1 1 1 1"/>
    <field name="slice" type="vec4" default="0 0 0 0"/>
  </component>

  <!-- A shaped run: the UTF-8 bytes in a blob, the size in pixels and the
       color the coverage masks. The adapter fills it from the Label's text
       authoring property. -->
  <component name="Text" version="2">
    <field name="content" type="blob"/>
    <field name="font_size" type="f32" default="24"/>
    <field name="font_weight" type="u16" default="400"/>
    <field name="text_color" type="vec4" default="1 1 1 1"/>
    <field name="align" type="TextAlign" default="Start"/>
    <field name="wrap" type="bool" default="true"/>
    <!-- `v_align` places the shaped ink inside the rect; `padding_left` insets
         the alignment span from the left edge. -->
    <field name="v_align" type="VAlign" default="Top"/>
    <field name="padding_left" type="f32" default="0.0"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- Compiled glyph quads in widget-local pixels: x/y/width/height plus the
       atlas UV rect. Derived by the adapter from Text. -->
  <component name="Glyphs" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- The shaped run's measured extent, written by the adapter. Layout uses it
       when the RectTransform leaves a dimension at zero. `advance` is where the
       shaped run ends on its last line (alignment offset included), which is
       where the caret sits; the ink extents cannot answer that (atlas padding
       and trailing spaces). -->
  <component name="TextMetrics" version="2" derived="true">
    <field name="width" type="f32"/>
    <field name="height" type="f32"/>
    <field name="advance" type="f32"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- The canvas's single font atlas: RGBA8 coverage pages and the revision
       the renderer compares before re-uploading. Derived by the adapter. -->
  <component name="TextAtlasPage" version="1" derived="true">
    <field name="width" type="u32"/>
    <field name="height" type="u32"/>
    <field name="revision" type="u32"/>
    <field name="pixels" type="blob"/>
  </component>

  <!-- The HUD's view model: gameplay or the demo writes these values; widgets
       bind their RectTransform fields to them. A later slice can bind straight
       to gameplay components. -->
  <component name="DataContext" version="1">
    <field name="health" type="f32" default="0"/>
    <field name="max_health" type="f32" default="1"/>
    <field name="ammo" type="f32" default="0"/>
    <field name="max_ammo" type="f32" default="1"/>
  </component>

  <!-- Compiled binding records, written by the UI adapter; a blob on the
       canvas so the binding system reads one dense range. -->
  <component name="Bindings" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- Interaction state of a widget. `activated` is true for the update in
       which a press was released inside it. -->
  <component name="Input" version="1">
    <field name="state" type="WidgetState" default="Normal"/>
    <field name="focusable" type="bool" default="true"/>
    <field name="activated" type="bool" default="false"/>
  </component>

  <!-- A clipped, vertically scrolling viewport. `scroll` is state the wheel
       handler moves; `content_height` is what layout measured, so the scroll
       range is known after the first pass. `step` binds scrolling to whole
       rows: zero scrolls continuously. -->
  <component name="ScrollView" version="2">
    <field name="scroll" type="f32" default="0.0"/>
    <field name="step" type="f32" default="0.0"/>
    <field name="content_height" type="f32" default="0.0"/>
    <!-- The scrollbar thumb; a zero alpha hides the bar. -->
    <field name="color" type="vec4" default="0.35 0.37 0.40 0.85"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- The pointer's current target, derived by the input system. `capture` is
       the widget an application handler took the pointer for on press: moves
       and the release route to it and the built-in gestures stand aside. -->
  <component name="PointerState" version="2" derived="true">
    <field name="hover" type="entity"/>
    <field name="press" type="entity"/>
    <field name="activated" type="entity"/>
    <field name="focused" type="entity"/>
    <field name="capture" type="entity"/>
    <field name="down" type="bool"/>

    <migrate from="1" to="2"/>
  </component>

  <!-- The caret of an editable text field: a byte offset into the UTF-8
       content. Derived by the editor paths; a field without one shows its
       caret at the end. -->
  <component name="TextCaret" version="1" derived="true">
    <field name="offset" type="u32"/>
  </component>

  <!-- A checkbox: an Input widget that draws a box on its left and toggles on
       click. The author reserves the box's room with Text padding_left. -->
  <component name="Checkbox" version="1">
    <field name="checked" type="bool" default="false"/>
    <field name="color" type="vec4" default="1 1 1 1"/>
  </component>

  <!-- A horizontal slider: an Input widget whose value jumps to a press and
       follows a drag between min and max. `color` tints the filled part and the
       knob; the empty track is the same colour dimmed. -->
  <component name="Slider" version="1">
    <field name="value" type="f32" default="0.0"/>
    <field name="min" type="f32" default="0.0"/>
    <field name="max" type="f32" default="1.0"/>
    <field name="color" type="vec4" default="1 1 1 1"/>
  </component>

  <!-- A combo box: an Input widget whose click toggles `open`. The one child
       carrying DropdownList is the popup: it paints and takes hits only while
       open, and a click on one of its item rows sets `selected` to that row's
       index and closes the box. -->
  <component name="Dropdown" version="1">
    <field name="open" type="bool" default="false"/>
    <field name="selected" type="u32" default="0"/>
  </component>

  <!-- Marks the popup panel of a Dropdown. -->
  <component name="DropdownList" version="1">
    <field name="enabled" type="bool" default="true"/>
  </component>

  <!-- A tab container: children carrying TabPage paint one at a time, the one
       whose index equals `active`. A click on a widget carrying Tab sets it. -->
  <component name="Tabs" version="1">
    <field name="active" type="u32" default="0"/>
  </component>

  <component name="TabPage" version="1">
    <field name="index" type="u32" default="0"/>
  </component>

  <component name="Tab" version="1">
    <field name="index" type="u32" default="0"/>
  </component>

  <!-- A draggable divider for absolutely positioned panes: a horizontal drag
       grows the previous sibling and moves the next one, the divider travelling
       with the edge. `axis` 0 splits horizontally, 1 vertically. -->
  <component name="Splitter" version="1">
    <field name="axis" type="u32" default="0"/>
  </component>

  <!-- A list row that highlights while selected: a click selects it and clears
       its siblings, so a list behaves like one choice. -->
  <component name="Selectable" version="1">
    <field name="selected" type="bool" default="false"/>
    <field name="color" type="vec4" default="0.0257 0.0684 0.1559 1"/>
  </component>

  <!-- A property label: dragging horizontally changes `value` by `step` per
       pixel. The application reads the value and clamps it to its own range. -->
  <component name="Scrubber" version="1">
    <field name="step" type="f32" default="1.0"/>
    <field name="value" type="f32" default="0.0"/>
  </component>

  <!-- The document key an instantiated widget was authored under, hashed, so
       application code reaches a named widget after the document is gone. -->
  <component name="WidgetKey" version="1" derived="true">
    <field name="hash" type="u64"/>
  </component>

  <!-- Animates state changes: a widget carrying Transition tweens its
       Background colour over `duration_ms` instead of jumping. Authored through
       style rules like any other component. -->
  <component name="Transition" version="1">
    <field name="duration_ms" type="u32" default="120"/>
  </component>

  <!-- One in-flight colour tween, derived by the state machinery. -->
  <component name="ColorTween" version="1" derived="true">
    <field name="from" type="vec4"/>
    <field name="to" type="vec4"/>
    <field name="elapsed" type="f32"/>
    <field name="duration" type="f32"/>
  </component>

  <!-- State-style overrides, compiled at instantiation; a blob on the canvas. -->
  <component name="StateStyles" version="1" derived="true">
    <field name="records" type="blob"/>
  </component>

  <!-- Reserved for the style compiler: the interned table entry a widget's
       class set resolves to. Layout does not read it. -->
  <component name="StyleRef" version="1">
    <field name="style" type="u32" default="0"/>
  </component>

  <!-- Named compositions. A node type is a flat set of components plus the
       fields its implicit attributes may set; there is no inheritance. -->
  <node name="Screen" version="1">
    <uses component="Canvas" expose="scale"/>
    <uses component="DataContext" expose="health max_health ammo max_ammo"/>
  </node>

  <node name="Panel" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color border_color border_width"/>
    <uses component="LayoutGroup"
          expose="direction justify align gap wrap padding_left padding_top padding_right padding_bottom"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <!-- A column viewport that clips and scrolls its children. -->
  <node name="Scroll" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color"/>
    <uses component="LayoutGroup"
          expose="direction justify align gap wrap padding_left padding_top padding_right padding_bottom"/>
    <uses component="ScrollView" expose="step"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Label" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color border_color border_width"/>
    <uses component="Text"
          expose="font_size font_weight text_color align wrap v_align padding_left"/>
    <field name="text" type="string"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Box" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color border_color border_width"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Picture" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Image" expose="texture uv_min uv_max tint slice"/>
    <!-- An image file registered at startup; the resolved id overrides the
       texture field. -->
    <field name="path" type="string"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <node name="Button" version="1">
    <uses component="RectTransform"
          expose="x y width height anchor_min anchor_max pivot z position"/>
    <uses component="Background" expose="color border_color border_width"/>
    <uses component="Input"/>
    <field name="bind-x" type="binding"/>
    <field name="bind-y" type="binding"/>
    <field name="bind-width" type="binding"/>
    <field name="bind-height" type="binding"/>
  </node>

  <!-- Non-visual style data. The UI compiler consumes the sheet; instantiation
       skips its subtree. A rule's component elements are declarations; a `src`
       names an external stylesheet whose sheets are imported when the document
       loads. Variable children feed var() references in declaration values;
       the last definition in document order wins. -->
  <node name="StyleSheet" version="1">
    <field name="src" type="string"/>
  </node>

  <node name="Variable" version="1">
    <field name="token" type="string"/>
    <field name="value" type="string"/>
  </node>

  <node name="StyleRule" version="1">
    <field name="selector" type="string"/>
  </node>

</schema>
