<?xml version="1.0" encoding="utf-8"?>
<document version="1" schemas="resonate.ui">
  <!-- The editor's shell: a toolbar over a scene tree, a viewport that shows the
       3D scene through it, and an inspector. Panes are laid out absolutely;
       the viewport keeps a transparent background so the renderer's frame
       shows through. Colors and the density rhythm come from the theme (see
       dev-note/research/sbox-ue5-editor.md); rows and controls are 24 px. -->
  <Screen key="editor" name="Editor">
    <StyleSheet key="theme" src="content/ui/theme.rcss"/>

    <Panel key="toolbar" class="toolbar" x="0" y="0" width="0" height="36"
           anchor_min="0 0" anchor_max="1 0"
           direction="Row" align="Center" gap="4"
           padding_left="12" padding_top="6" padding_right="12" padding_bottom="6">
      <Label key="brand" class="label" width="150" height="24" text="Resonate Editor"
             font_size="13" font_weight="600" v_align="Middle"/>
      <Box key="tb-sep-1" class="separator" width="1" height="18"/>
      <Button key="tb-open" class="tool" width="24" height="24">
        <Icon key="tb-open-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="folder-open"/>
      </Button>
      <Button key="tb-save" class="tool" width="24" height="24">
        <Icon key="tb-save-icon" class="icon" x="4" y="4" width="16" height="16" icon="save"/>
      </Button>
      <Button key="tb-undo" class="tool" width="24" height="24">
        <Icon key="tb-undo-icon" class="icon" x="4" y="4" width="16" height="16" icon="undo-2"/>
      </Button>
      <Button key="tb-redo" class="tool" width="24" height="24">
        <Icon key="tb-redo-icon" class="icon" x="4" y="4" width="16" height="16" icon="redo-2"/>
      </Button>
      <Box key="tb-sep-edit" class="separator" width="1" height="18"/>
      <Button key="tb-duplicate" class="tool" width="24" height="24">
        <Icon key="tb-duplicate-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="copy"/>
      </Button>
      <Button key="tb-delete" class="tool" width="24" height="24">
        <Icon key="tb-delete-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="trash-2"/>
      </Button>
      <Box key="tb-sep-2" class="separator" width="1" height="18"/>
      <Button key="tb-play" class="tool" width="24" height="24">
        <Icon key="tb-play-icon" class="icon-accent" x="4" y="4" width="16" height="16"
              icon="play"/>
      </Button>
      <Box key="tb-sep-3" class="separator" width="1" height="18"/>
      <Button key="file" class="tool" width="56" height="24">
        <Label key="file-label" class="label" width="56" height="24" text="文件"
               font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
      </Button>
      <Button key="edit" class="tool" width="56" height="24">
        <Label key="edit-label" class="label" width="56" height="24" text="编辑"
               font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
      </Button>
      <Button key="view" class="tool" width="56" height="24">
        <Label key="view-label" class="label" width="56" height="24" text="视图"
               font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
      </Button>
      <Box key="tb-sep-4" class="separator" width="1" height="18"/>
      <Button key="tb-scene-pane" class="tool" width="24" height="24">
        <Icon key="tb-scene-pane-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="panel-left"/>
      </Button>
      <Button key="tb-inspector" class="tool" width="24" height="24">
        <Icon key="tb-inspector-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="sliders-horizontal"/>
      </Button>
      <Button key="tb-console" class="tool" width="24" height="24">
        <Icon key="tb-console-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="terminal"/>
      </Button>
      <Button key="tb-machine" class="tool" width="24" height="24">
        <Icon key="tb-machine-icon" class="icon" x="4" y="4" width="16" height="16"
              icon="git-branch"/>
      </Button>
    </Panel>
    <Box key="toolbar-line" class="separator" x="0" y="36" width="0" height="1"
         anchor_min="0 0" anchor_max="1 0"/>

    <Panel key="scene-pane" class="panel" x="0" y="37" width="280" height="-63"
           anchor_min="0 0" anchor_max="0 1"
           direction="Column" align="Stretch" gap="0">
      <Label key="scene-header" class="pane-title" height="28" text="场景"
             font_size="12" font_weight="600" v_align="Middle" padding_left="12"/>
      <Box key="scene-header-line" class="separator" height="1"/>
      <Scroll key="scene-list" position="Absolute" x="0" y="29" width="0" height="-29"
              step="24" anchor_min="0 0" anchor_max="1 1"
              direction="Column" align="Stretch" gap="0"
              padding_left="0" padding_top="0" padding_right="0" padding_bottom="0">
        <Row key="camera" class="outliner-row" height="24" selected="false">
          <Icon key="camera-icon" class="icon" x="4" y="4" width="16" height="16" icon="camera"/>
          <Label key="camera-label" class="label" x="24" y="3" width="236" height="18"
                 text="主相机" font_size="12" v_align="Middle" wrap="false" ellipsis="true"/>
        </Row>
        <Row key="sun" class="outliner-row" height="24" selected="false">
          <Icon key="sun-icon" class="icon" x="4" y="4" width="16" height="16" icon="sun"/>
          <Label key="sun-label" class="label" x="24" y="3" width="236" height="18"
                 text="平行光" font_size="12" v_align="Middle" wrap="false" ellipsis="true"/>
        </Row>
        <Row key="ground" class="outliner-row" height="24" selected="false">
          <Icon key="ground-icon" class="icon" x="4" y="4" width="16" height="16" icon="box"/>
          <Label key="ground-label" class="label" x="24" y="3" width="236" height="18"
                 text="地面" font_size="12" v_align="Middle" wrap="false" ellipsis="true"/>
        </Row>
        <!-- The first object's row: the editor reshapes its caption from the
             entity and clones it for every further object. -->
        <Row key="crate-a" class="outliner-row" height="24" selected="true">
          <Icon key="crate-a-icon" class="icon-bright" x="4" y="4" width="16" height="16"
                icon="box"/>
          <Label key="crate-a-label" class="label" x="24" y="3" width="236" height="18"
                 text="箱子 A" font_size="12" v_align="Middle" wrap="false" ellipsis="true"/>
        </Row>      </Scroll>
    </Panel>

    <Box key="splitter-left" class="splitter" x="280" y="37" width="6" height="-63"
         anchor_min="0 0" anchor_max="0 1">
      <Splitter axis="0" target="scene-pane"/>
    </Box>
    <Box key="viewport" x="286" y="37" width="-572" height="-309"
         anchor_min="0 0" anchor_max="1 1" color="0 0 0 0"/>
    <Label key="viewport-hint" class="prop-label" x="302" y="52" width="220" height="20"
           text="视口" font_size="12" v_align="Middle"/>
    <Box key="splitter-right" class="splitter" x="-286" y="37" width="6" height="-63"
         anchor_min="1 0" anchor_max="1 1">
      <Splitter axis="0" target="inspector"/>
    </Box>

    <Panel key="console" class="panel" x="286" y="-266" width="-572" height="240"
           anchor_min="0 1" anchor_max="1 1"
           direction="Column" align="Stretch" gap="0">
      <Label key="console-header" class="pane-title" height="28" text="控制台"
             font_size="12" font_weight="600" v_align="Middle" padding_left="12"/>
      <Box key="console-header-line" class="separator" height="1"/>
      <Label key="console-line" class="label-dim" height="22" text="就绪。"
             font_size="12" v_align="Middle" padding_left="12"/>
      <Panel key="command-row" height="28" direction="Row" align="Center" gap="4"
             padding_left="12" padding_top="2" padding_right="12" padding_bottom="2">
        <Label key="command-field" class="field label" text=""
               placeholder="输入命令（set / get / find）" font_size="12" height="24"
               v_align="Middle" padding_left="6">
          <Input/>
          <LayoutItem grow="1"/>
        </Label>
        <Button key="command-run" class="button" width="56" height="24">
          <Label key="command-run-label" class="label" width="56" height="24" text="运行"
                 font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
        </Button>
      </Panel>
    </Panel>

    <!-- The console's edge: dragging it sizes the console, whose height the
         editor re-derives from this divider's position. -->
    <Box key="splitter-console" class="splitter" x="286" y="-272" width="-572" height="6"
         anchor_min="0 1" anchor_max="1 1">
      <Splitter axis="1" target="console"/>
    </Box>

    <Panel key="machine" class="panel" x="-566" y="37" width="280" height="-63"
           shown="false"
           anchor_min="1 0" anchor_max="1 1"
           direction="Column" align="Stretch" gap="0"
           padding_left="0" padding_top="0" padding_right="0" padding_bottom="12">
      <Label key="machine-header" class="pane-title" height="28" text="状态机"
             font_size="12" font_weight="600" v_align="Middle" padding_left="12"/>
      <Box key="machine-header-line" class="separator" height="1"/>
      <Label key="machine-empty" class="label-dim" height="22" text="选中带状态机的对象"
             font_size="12" v_align="Middle" padding_left="12"/>
      <Panel key="machine-buttons" position="Absolute" x="0" y="-32" width="0" height="30"
             anchor_min="0 1" anchor_max="1 1"
             direction="Row" align="Center" gap="4" padding_left="12" padding_right="12">
        <Button key="machine-add-state" class="button" width="76" height="24">
          <Label key="machine-add-state-label" class="label" width="76" height="24" text="添加状态"
                 font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
        </Button>
        <Button key="machine-add-transition" class="button" width="76" height="24">
          <Label key="machine-add-transition-label" class="label" width="76" height="24" text="添加转换"
                 font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
        </Button>
        <Button key="machine-delete" class="button" width="76" height="24">
          <Label key="machine-delete-label" class="label" width="76" height="24" text="删除所选"
                 font_size="12" v_align="Middle" align="Center" color="0 0 0 0"/>
        </Button>
      </Panel>
      <Scroll key="machine-scroll" position="Absolute" x="0" y="29" width="0" height="-62"
              step="24" anchor_min="0 0" anchor_max="1 1"
              direction="Column" align="Stretch" gap="0"
              padding_left="0" padding_top="0" padding_right="0" padding_bottom="0">
        <Panel key="machine-state-row" height="24" direction="Row" align="Center" gap="6"
               padding_left="12" padding_right="12">
          <Label key="machine-state-caption" class="label" height="24" text="状态"
                 font_size="12" v_align="Middle">
            <LayoutItem grow="1"/>
          </Label>
          <Selectable color="0.16 0.17 0.19 1"/>
        </Panel>
        <Panel key="machine-transition-row" height="24" direction="Row" align="Center" gap="6"
               padding_left="12" padding_right="12">
          <Label key="machine-transition-caption" class="label-dim" height="24" text="转换"
                 font_size="12" v_align="Middle">
            <LayoutItem grow="1"/>
          </Label>
          <Selectable color="0.16 0.17 0.19 1"/>
        </Panel>
      </Scroll>
    </Panel>

    <Box key="splitter-machine" class="splitter" x="-572" y="37" width="6" height="-63"
         shown="false"
         anchor_min="1 0" anchor_max="1 1">
      <Splitter axis="0" target="machine"/>
    </Box>

    <Panel key="inspector" class="panel" x="-280" y="37" width="280" height="-63"
           anchor_min="1 0" anchor_max="1 1"
           direction="Column" align="Stretch" gap="0"
           padding_left="0" padding_top="0" padding_right="0" padding_bottom="12">
      <Label key="inspector-header" class="pane-title" height="28" text="检查器"
             font_size="12" font_weight="600" v_align="Middle" padding_left="12"/>
      <Box key="inspector-header-line" class="separator" height="1"/>
      <Box key="gap-object" height="8"/>
      <Label key="section-object" class="section-title" height="24" text="对象"
             font_size="11" font_weight="600" v_align="Middle" padding_left="12"/>
      <Panel key="name-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="name-label" class="prop-label" width="76" height="24" text="名称"
               font_size="12" v_align="Middle"/>
        <Label key="name-field" class="field label" text="箱子 A" font_size="12" height="24"
               v_align="Middle" padding_left="6">
          <Input/>
          <LayoutItem grow="1"/>
        </Label>
      </Panel>
      <Box key="gap-transform" height="8"/>
      <Label key="section-transform" class="section-title" height="24" text="变换"
             font_size="11" font_weight="600" v_align="Middle" padding_left="12"/>
      <Panel key="animation-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="animation-title" class="prop-label" width="76" height="24" text="动画"
               font_size="12" v_align="Middle"/>
        <Label key="animation-value" class="prop-value" width="150" height="24" text="-"
               font_size="12" v_align="Middle"/>
      </Panel>
      <Panel key="position-x-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="position-x-label" class="prop-label" width="76" height="24" text="位置 X"
               font_size="12" v_align="Middle"/>
        <Label key="position-x" class="field label" text="0.00" font_size="12" height="24"
               v_align="Middle" padding_left="6">
          <Input/>
          <LayoutItem grow="1"/>
        </Label>
      </Panel>
      <Panel key="position-y-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="position-y-label" class="prop-label" width="76" height="24" text="位置 Y"
               font_size="12" v_align="Middle"/>
        <Label key="position-y" class="field label" text="0.00" font_size="12" height="24"
               v_align="Middle" padding_left="6">
          <Input/>
          <LayoutItem grow="1"/>
        </Label>
      </Panel>
      <Panel key="position-z-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="position-z-label" class="prop-label" width="76" height="24" text="位置 Z"
               font_size="12" v_align="Middle"/>
        <Label key="position-z" class="field label" text="0.00" font_size="12" height="24"
               v_align="Middle" padding_left="6">
          <Input/>
          <LayoutItem grow="1"/>
        </Label>
      </Panel>
      <Box key="gap-material" height="8"/>
      <Label key="section-material" class="section-title" height="24" text="材质"
             font_size="11" font_weight="600" v_align="Middle" padding_left="12"/>
      <Panel key="opacity-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="opacity-title" class="prop-label" width="76" height="24" text="不透明度"
               font_size="12" v_align="Middle"/>
        <Label key="opacity-scrub" class="field scrub label" text="拖动调值" font_size="12"
               height="24" v_align="Middle" padding_left="6">
          <Input/>
          <Scrubber step="0.01" value="1.0"/>
          <LayoutItem grow="1"/>
        </Label>
        <Label key="opacity-value" class="prop-value" width="44" height="24" text="1.00"
               font_size="12" v_align="Middle" align="End"/>
      </Panel>
      <Panel key="roughness-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="roughness-title" class="prop-label" width="76" height="24" text="粗糙度"
               font_size="12" v_align="Middle"/>
        <Label key="roughness-scrub" class="field scrub label" text="拖动调值" font_size="12"
               height="24" v_align="Middle" padding_left="6">
          <Input/>
          <Scrubber step="0.01" value="0.5"/>
          <LayoutItem grow="1"/>
        </Label>
        <Label key="roughness-value" class="prop-value" width="44" height="24" text="0.50"
               font_size="12" v_align="Middle" align="End"/>
      </Panel>
      <Panel key="metallic-row" height="24" direction="Row" align="Center" gap="8" padding_left="12" padding_right="12">
        <Label key="metallic-title" class="prop-label" width="76" height="24" text="金属度"
               font_size="12" v_align="Middle"/>
        <Label key="metallic-scrub" class="field scrub label" text="拖动调值" font_size="12"
               height="24" v_align="Middle" padding_left="6">
          <Input/>
          <Scrubber step="0.01" value="0.0"/>
          <LayoutItem grow="1"/>
        </Label>
        <Label key="metallic-value" class="prop-value" width="44" height="24" text="0.00"
               font_size="12" v_align="Middle" align="End"/>
      </Panel>
    </Panel>

    <Box key="status-line" class="separator" x="0" y="-27" width="0" height="1"
         anchor_min="0 1" anchor_max="1 1"/>
    <Panel key="status-bar" class="status-bar" x="0" y="-26" width="0" height="26"
           anchor_min="0 1" anchor_max="1 1"
           direction="Row" align="Center" gap="16"
           padding_left="12" padding_top="0" padding_right="12" padding_bottom="0">
      <Label key="status" class="label-dim" width="360" height="24" text="已选择 箱子 A"
             font_size="11" v_align="Middle"/>
      <Label key="status-count" class="label-dim" width="160" height="24" text="4 个对象"
             font_size="11" v_align="Middle"/>
      <Label key="status-fps" class="label-dim" width="120" height="24" text="60 fps"
             font_size="11" v_align="Middle"/>
    </Panel>
  </Screen>
</document>
