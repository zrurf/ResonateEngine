<?xml version="1.0" encoding="utf-8"?>
<document version="1" schemas="resonate.ui">
  <!-- The start-up HUD: a panel with a title, two bars and a button, all
       implicit node types. The layout pass resolves the exposed attributes into
       the default RectTransform/Background/LayoutGroup components. -->
  <Screen key="hud" name="HUD" health="240" max_health="336" ammo="90" max_ammo="336">
    <StyleSheet key="styles">
      <StyleRule selector=".panel">
        <Background color="0.06 0.07 0.10 0.92"/>
      </StyleRule>
      <StyleRule selector=".title">
        <Background color="0.20 0.42 0.90 1"/>
      </StyleRule>
      <StyleRule selector=".bar">
        <Background color="0.35 0.84 0.45 1"/>
      </StyleRule>
      <StyleRule selector=".bar.ammo">
        <Background color="0.92 0.52 0.30 1"/>
      </StyleRule>
      <StyleRule selector=".action">
        <Background color="0.16 0.22 0.34 1"/>
      </StyleRule>
      <StyleRule selector=".action:hover">
        <Background color="0.24 0.34 0.52 1"/>
      </StyleRule>
      <StyleRule selector=".action:pressed">
        <Background color="0.10 0.15 0.25 1"/>
      </StyleRule>
    </StyleSheet>

    <Panel key="panel" id="hud-panel" name="Panel" class="panel"
           x="40" y="40" width="360" height="180"
           direction="Column" align="Start" gap="8"
           padding_left="12" padding_top="12" padding_right="12" padding_bottom="12">
      <Label key="title" name="Title" class="title" width="336" height="28"/>
      <Label key="bar.health" name="Health" class="bar" height="16"
             bind-width="DataContext.health"/>
      <Label key="bar.ammo" name="Ammo" class="bar ammo" height="16"
             bind-width="DataContext.ammo"/>
      <Button key="action" name="Action" class="action" width="140" height="36"/>
    </Panel>
  </Screen>
</document>
