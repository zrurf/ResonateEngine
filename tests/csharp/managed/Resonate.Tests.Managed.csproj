<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Resonate.Tests.Managed</AssemblyName>
    <RootNamespace>Resonate.Tests.Managed</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Tick writes through the native context pointer: the zero-marshal path. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- hostfxr loads this as a component: the publish drops a runtimeconfig
         beside the assembly for the initializer to read. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

</Project>
