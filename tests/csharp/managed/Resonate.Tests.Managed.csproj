<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Resonate.Tests.Managed</AssemblyName>
    <RootNamespace>Resonate.Tests.Managed</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Tick writes through the native context pointer: the zero-marshal path. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- hostfxr loads this as a component: the publish drops a runtimeconfig
         beside the assembly for the initializer to read. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- The build generates the binding ids (csbind) and the component views
       (schemac) into build/gen/csharp before the publish; both are sources. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../build/gen/csharp/**/*.g.cs" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/tools/analyzers/Resonate.CSharp.Attributes/Resonate.CSharp.Attributes.csproj" />
    <!-- The behaviour laws and the registration generator run in this build. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../packages/tools/analyzers/Resonate.Analyzers/Resonate.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
